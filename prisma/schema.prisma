// MatrimonyOS Prisma Schema
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AppRole {
  MEMBER
  PREMIUM_MEMBER
  FAMILY_MANAGER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ProfileFor {
  SELF
  SON
  DAUGHTER
  BROTHER
  SISTER
  RELATIVE
  FRIEND
}

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
  ANNULLED
}

enum FamilyType {
  NUCLEAR
  JOINT
}

enum PhotoModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProfileVisibility {
  PUBLIC
  MEMBERS_ONLY
  PRIVATE
}

enum InterestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum ReportReason {
  HARASSMENT
  SPAM
  FAKE_PROFILE
  INAPPROPRIATE_CONTENT
  SCAM_SUSPICIOUS
  OTHER
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum NotificationType {
  INTEREST_RECEIVED
  INTEREST_ACCEPTED
  INTEREST_DECLINED
  MUTUAL_MATCH_CREATED
  NEW_MESSAGE
  SYSTEM_ANNOUNCEMENT
}

// -----------------------------------------------------------------------------
// Better Auth Core Authentication Entities
// -----------------------------------------------------------------------------

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false) @map("email_verified")
  image         String?
  accountStatus AccountStatus @default(PENDING_VERIFICATION) @map("account_status")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  sessions           Session[]
  accounts           Account[]
  roles              UserRole[]
  matrimonialProfile MatrimonialProfile?
  shortlists         ProfileShortlist[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

// -----------------------------------------------------------------------------
// Role-Based Access Control (RBAC)
// -----------------------------------------------------------------------------

model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  role      AppRole
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_roles")
}

// -----------------------------------------------------------------------------
// Phase 4: Matrimonial Profile & Onboarding Entities
// -----------------------------------------------------------------------------

model MatrimonialProfile {
  id                   String           @id @default(cuid())
  userId               String           @unique @map("user_id")
  slug                 String           @unique
  onboardingStatus     OnboardingStatus @default(NOT_STARTED) @map("onboarding_status")
  onboardingStep       Int              @default(1) @map("onboarding_step")
  completionPercentage Int              @default(0) @map("completion_percentage")

  // Step 1: Basic Information
  profileFor         ProfileFor?    @map("profile_for")
  fullName           String?        @map("full_name")
  dateOfBirth        DateTime?      @map("date_of_birth")
  gender             Gender?
  maritalStatus      MaritalStatus? @map("marital_status")
  countryOfResidence String?        @map("country_of_residence")
  cityOfResidence    String?        @map("city_of_residence")
  nationality        String?
  preferredLanguage  String?        @map("preferred_language")

  // Step 2: Personal Details
  heightCm           Int?    @map("height_cm")
  weightKg           Int?    @map("weight_kg")
  bodyType           String? @map("body_type")
  complexion         String?
  religion           String?
  religiousPractice  String? @map("religious_practice")
  communityEthnicity String? @map("community_ethnicity")
  disabilityInfo     String? @map("disability_info")
  aboutMe            String? @map("about_me") @db.Text

  // Step 4: Career & Professional Information
  employmentStatus  String? @map("employment_status")
  profession        String?
  jobTitle          String? @map("job_title")
  industry          String?
  employer          String?
  incomeCurrency    String? @default("USD") @map("income_currency")
  annualIncomeRange String? @map("annual_income_range")
  workLocation      String? @map("work_location")
  careerDescription String? @map("career_description") @db.Text

  // Step 5: Family Information
  familyType           FamilyType? @map("family_type")
  familyValues         String?     @map("family_values")
  fatherOccupation     String?     @map("father_occupation")
  motherOccupation     String?     @map("mother_occupation")
  brothersCount        Int         @default(0) @map("brothers_count")
  sistersCount         Int         @default(0) @map("sisters_count")
  brothersMarriedCount Int         @default(0) @map("brothers_married_count")
  sistersMarriedCount  Int         @default(0) @map("sisters_married_count")
  familyLocation       String?     @map("family_location")
  familyBackground     String?     @map("family_background") @db.Text

  // Step 6: Lifestyle
  dietaryHabits        String?  @map("dietary_habits")
  smokingHabits        String?  @map("smoking_habits")
  drinkingHabits       String?  @map("drinking_habits")
  exerciseHabits       String?  @map("exercise_habits")
  livingArrangement    String?  @map("living_arrangement")
  hobbies              String[] @default([])
  languages            String[] @default([])
  lifestyleDescription String?  @map("lifestyle_description") @db.Text

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  educations        ProfileEducation[]
  photos            ProfilePhoto[]
  partnerPreference PartnerPreference?
  privacySettings   ProfilePrivacySettings?

  // Phase 5: Matching, Shortlist & Interest Relationships
  shortlistsCreated ProfileShortlist[]    @relation("ShortlistsCreated")
  shortlistedBy     ProfileShortlist[]    @relation("ShortlistedBy")
  interestsSent     MatrimonialInterest[] @relation("InterestsSent")
  interestsReceived MatrimonialInterest[] @relation("InterestsReceived")
  matchesAsProfile1 MutualMatch[]         @relation("MatchesAsProfile1")
  matchesAsProfile2 MutualMatch[]         @relation("MatchesAsProfile2")

  // Phase 6: Messaging, Safety & Notifications
  conversationsAsP1      Conversation[]          @relation("ConversationsAsP1")
  conversationsAsP2      Conversation[]          @relation("ConversationsAsP2")
  sentMessages           Message[]               @relation("SentMessages")
  blockedUsers           UserBlock[]             @relation("BlockedUsers")
  blockedByUsers         UserBlock[]             @relation("BlockedByUsers")
  reportsSubmitted       UserReport[]            @relation("ReportsSubmitted")
  reportsReceived        UserReport[]            @relation("ReportsReceived")
  notificationsReceived  Notification[]          @relation("NotificationsReceived")
  notificationsSent      Notification[]          @relation("NotificationsSent")
  notificationPreference NotificationPreference?

  @@index([userId])
  @@index([slug])
  @@index([gender, maritalStatus, religion])
  @@map("matrimonial_profiles")
}

model ProfileEducation {
  id                       String   @id @default(cuid())
  profileId                String   @map("profile_id")
  educationLevel           String   @map("education_level")
  degree                   String
  fieldOfStudy             String   @map("field_of_study")
  institution              String
  country                  String
  graduationYear           Int      @map("graduation_year")
  additionalQualifications String?  @map("additional_qualifications") @db.Text
  isHighest                Boolean  @default(false) @map("is_highest")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  profile MatrimonialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("profile_educations")
}

model ProfilePhoto {
  id                  String                @id @default(cuid())
  profileId           String                @map("profile_id")
  cloudinaryPublicId  String                @map("cloudinary_public_id")
  secureUrl           String                @map("secure_url")
  isPrimary           Boolean               @default(false) @map("is_primary")
  orderIndex          Int                   @default(0) @map("order_index")
  moderationStatus    PhotoModerationStatus @default(PENDING) @map("moderation_status")
  rejectionReason     String?               @map("rejection_reason")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  profile MatrimonialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("profile_photos")
}

model PartnerPreference {
  id                     String   @id @default(cuid())
  profileId              String   @unique @map("profile_id")
  minAge                 Int?     @map("min_age")
  maxAge                 Int?     @map("max_age")
  minHeightCm            Int?     @map("min_height_cm")
  maxHeightCm            Int?     @map("max_height_cm")
  maritalStatus          String[] @default([]) @map("marital_status")
  educationLevels        String[] @default([]) @map("education_levels")
  professions            String[] @default([])
  countries              String[] @default([])
  cities                 String[] @default([])
  nationalities          String[] @default([])
  religions              String[] @default([])
  familyTypes            String[] @default([]) @map("family_types")
  lifestyles             String[] @default([])
  additionalExpectations String?  @map("additional_expectations") @db.Text
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  profile MatrimonialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("partner_preferences")
}

model ProfilePrivacySettings {
  id                String            @id @default(cuid())
  profileId         String            @unique @map("profile_id")
  profileVisibility ProfileVisibility @default(MEMBERS_ONLY) @map("profile_visibility")
  photoVisibility   ProfileVisibility @default(MEMBERS_ONLY) @map("photo_visibility")
  showDateOfBirth   Boolean           @default(false) @map("show_date_of_birth")
  showContactInfo   Boolean           @default(false) @map("show_contact_info")
  showIncome        Boolean           @default(false) @map("show_income")
  showEmployer      Boolean           @default(false) @map("show_employer")
  showFamilyDetails Boolean           @default(true) @map("show_family_details")
  showLocation      Boolean           @default(true) @map("show_location")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  profile MatrimonialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("profile_privacy_settings")
}

// -----------------------------------------------------------------------------
// Phase 5: Discovery, Matching, Shortlist & Interest Entities
// -----------------------------------------------------------------------------

model ProfileShortlist {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  profileId       String   @map("profile_id")
  targetProfileId String   @map("target_profile_id")
  createdAt       DateTime @default(now()) @map("created_at")

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile       MatrimonialProfile @relation("ShortlistsCreated", fields: [profileId], references: [id], onDelete: Cascade)
  targetProfile MatrimonialProfile @relation("ShortlistedBy", fields: [targetProfileId], references: [id], onDelete: Cascade)

  @@unique([profileId, targetProfileId])
  @@index([profileId])
  @@index([targetProfileId])
  @@index([userId])
  @@map("profile_shortlists")
}

model MatrimonialInterest {
  id                 String         @id @default(cuid())
  senderProfileId    String         @map("sender_profile_id")
  recipientProfileId String         @map("recipient_profile_id")
  status             InterestStatus @default(PENDING)
  message            String?        @db.Text
  respondedAt        DateTime?      @map("responded_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  senderProfile    MatrimonialProfile @relation("InterestsSent", fields: [senderProfileId], references: [id], onDelete: Cascade)
  recipientProfile MatrimonialProfile @relation("InterestsReceived", fields: [recipientProfileId], references: [id], onDelete: Cascade)
  matches          MutualMatch[]

  @@unique([senderProfileId, recipientProfileId])
  @@index([senderProfileId, status])
  @@index([recipientProfileId, status])
  @@index([senderProfileId, createdAt])
  @@map("matrimonial_interests")
}

model MutualMatch {
  id         String   @id @default(cuid())
  profile1Id String   @map("profile1_id")
  profile2Id String   @map("profile2_id")
  matchedAt  DateTime @default(now()) @map("matched_at")
  interestId String?  @map("interest_id")

  profile1 MatrimonialProfile   @relation("MatchesAsProfile1", fields: [profile1Id], references: [id], onDelete: Cascade)
  profile2 MatrimonialProfile   @relation("MatchesAsProfile2", fields: [profile2Id], references: [id], onDelete: Cascade)
  interest MatrimonialInterest? @relation(fields: [interestId], references: [id], onDelete: SetNull)
  conversation Conversation?

  @@unique([profile1Id, profile2Id])
  @@index([profile1Id])
  @@index([profile2Id])
  @@map("mutual_matches")
}

// -----------------------------------------------------------------------------
// Phase 6: Secure Messaging, Conversations & Notifications
// -----------------------------------------------------------------------------

model Conversation {
  id                   String   @id @default(cuid())
  matchId              String?  @unique @map("match_id")
  participant1Id       String   @map("participant1_id")
  participant2Id       String   @map("participant2_id")
  lastMessageAt        DateTime? @map("last_message_at")
  lastMessageText      String?  @map("last_message_text") @db.Text
  participant1Archived Boolean  @default(false) @map("participant1_archived")
  participant2Archived Boolean  @default(false) @map("participant2_archived")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  match        MutualMatch?       @relation(fields: [matchId], references: [id], onDelete: SetNull)
  participant1 MatrimonialProfile @relation("ConversationsAsP1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2 MatrimonialProfile @relation("ConversationsAsP2", fields: [participant2Id], references: [id], onDelete: Cascade)
  messages     Message[]
  reports      UserReport[]

  @@unique([participant1Id, participant2Id])
  @@index([participant1Id])
  @@index([participant2Id])
  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id                   String        @id @default(cuid())
  conversationId       String        @map("conversation_id")
  senderProfileId      String        @map("sender_profile_id")
  content              String?       @db.Text
  status               MessageStatus @default(SENT)
  deliveredAt          DateTime?     @map("delivered_at")
  readAt               DateTime?     @map("read_at")
  isDeletedBySender    Boolean       @default(false) @map("is_deleted_by_sender")
  isDeletedByRecipient Boolean       @default(false) @map("is_deleted_by_recipient")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  conversation Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       MatrimonialProfile @relation("SentMessages", fields: [senderProfileId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]
  reports      UserReport[]

  @@index([conversationId, createdAt])
  @@index([conversationId, status])
  @@index([senderProfileId])
  @@map("messages")
}

model MessageAttachment {
  id                 String   @id @default(cuid())
  messageId          String   @map("message_id")
  cloudinaryPublicId String   @map("cloudinary_public_id")
  secureUrl          String   @map("secure_url")
  format             String
  bytes              Int
  width              Int?
  height             Int?
  createdAt          DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

model UserBlock {
  id               String   @id @default(cuid())
  blockerProfileId String   @map("blocker_profile_id")
  blockedProfileId String   @map("blocked_profile_id")
  reason           String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  blocker MatrimonialProfile @relation("BlockedUsers", fields: [blockerProfileId], references: [id], onDelete: Cascade)
  blocked MatrimonialProfile @relation("BlockedByUsers", fields: [blockedProfileId], references: [id], onDelete: Cascade)

  @@unique([blockerProfileId, blockedProfileId])
  @@index([blockerProfileId])
  @@index([blockedProfileId])
  @@map("user_blocks")
}

model UserReport {
  id                     String       @id @default(cuid())
  reporterProfileId      String       @map("reporter_profile_id")
  reportedProfileId      String       @map("reported_profile_id")
  reportedMessageId      String?      @map("reported_message_id")
  reportedConversationId String?      @map("reported_conversation_id")
  reason                 ReportReason
  description            String?      @db.Text
  status                 ReportStatus @default(PENDING)
  resolvedAt             DateTime?    @map("resolved_at")
  resolutionNotes        String?      @map("resolution_notes") @db.Text
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  reporter             MatrimonialProfile @relation("ReportsSubmitted", fields: [reporterProfileId], references: [id], onDelete: Cascade)
  reportedProfile      MatrimonialProfile @relation("ReportsReceived", fields: [reportedProfileId], references: [id], onDelete: Cascade)
  reportedMessage      Message?           @relation(fields: [reportedMessageId], references: [id], onDelete: SetNull)
  reportedConversation Conversation?      @relation(fields: [reportedConversationId], references: [id], onDelete: SetNull)

  @@index([reporterProfileId])
  @@index([reportedProfileId])
  @@index([status])
  @@map("user_reports")
}

model Notification {
  id                 String           @id @default(cuid())
  recipientProfileId String           @map("recipient_profile_id")
  senderProfileId    String?          @map("sender_profile_id")
  type               NotificationType
  title              String
  body               String           @db.Text
  link               String?
  entityId           String?          @map("entity_id")
  isRead             Boolean          @default(false) @map("is_read")
  readAt             DateTime?        @map("read_at")
  createdAt          DateTime         @default(now()) @map("created_at")

  recipient MatrimonialProfile  @relation("NotificationsReceived", fields: [recipientProfileId], references: [id], onDelete: Cascade)
  sender    MatrimonialProfile? @relation("NotificationsSent", fields: [senderProfileId], references: [id], onDelete: SetNull)

  @@index([recipientProfileId, isRead])
  @@index([recipientProfileId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id             String   @id @default(cuid())
  profileId      String   @unique @map("profile_id")
  inAppInterests Boolean  @default(true) @map("in_app_interests")
  inAppMatches   Boolean  @default(true) @map("in_app_matches")
  inAppMessages  Boolean  @default(true) @map("in_app_messages")
  emailInterests Boolean  @default(true) @map("email_interests")
  emailMatches   Boolean  @default(true) @map("email_matches")
  emailMessages  Boolean  @default(true) @map("email_messages")
  emailSystem    Boolean  @default(true) @map("email_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  profile MatrimonialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("notification_preferences")
}
