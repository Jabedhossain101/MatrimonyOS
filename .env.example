# ------------------------------------------------------------------------------
# MatrimonyOS Environment Configuration (.env.example)
# Copy this file to .env and provide your actual cloud credentials.
# NEVER commit the real .env file with secrets to Git.
# ------------------------------------------------------------------------------

# Environment Mode
NODE_ENV="development"

# Neon PostgreSQL Database Credentials
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[database]?sslmode=require"
DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[database]?sslmode=require"

# Application Authentication Secret
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-super-secret-auth-key-min-32-characters-for-security"

# Application Public URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth Credentials (Optional in Development, required for Google sign-in)
# Obtain from Google Cloud Console (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend Email Integration (Optional in Development; logs to console if absent)
# Obtain from Resend (https://resend.com/api-keys)
RESEND_API_KEY=""
EMAIL_FROM="MatrimonyOS <no-reply@matrimonyos.com>"

# Cloudinary Media Storage (Optional in Development; mock/local preview used if absent)
# Obtain from Cloudinary Dashboard (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ------------------------------------------------------------------------------
# Phase 8: bKash Payment Gateway & Subscription Billing (Server-Side Only)
# Official Docs: https://developer.bka.sh/docs
# Sandbox URL: https://tokenized.sandbox.bka.sh/v1.2.0-beta
# Live URL:    https://tokenized.pay.bka.sh/v1.2.0-beta
# ------------------------------------------------------------------------------
PAYMENTS_ENABLED="false"

BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_IS_SANDBOX="true"

BKASH_WEBHOOK_ENABLED="false"
BKASH_AGREEMENT_ENABLED="false"

PAYMENT_CRON_SECRET=""


